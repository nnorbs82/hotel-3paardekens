---
interface Props {
  room: {
    id: string;
    name: string;
    strapline?: string;
    description: string;
    amenities: string[];
    gallery: string[];
    bookingUrl: string;
  };
}

const { room } = Astro.props;
---

<article class="room-card">
  <a class="room-card-image" href={`/rooms#${room.id}`} aria-label={`View ${room.name}`}>
    <img src={room.gallery[0]} alt={`${room.name} at Hotel 3 Paardekens`} loading="lazy" />
    <span class="room-card-number">{String(room.id === 'single' ? 1 : room.id === 'twin' ? 2 : 3).padStart(2, '0')}</span>
  </a>
  <div class="room-card-body">
    <p class="eyebrow">{room.strapline}</p>
    <h3>{room.name}</h3>
    <p>{room.description}</p>
    <ul class="room-card-amenities" aria-label={`${room.name} highlights`}>
      {room.amenities.slice(0, 3).map((amenity) => <li>{amenity}</li>)}
    </ul>
    <div class="room-card-actions">
      <a class="text-link" href={`/rooms#${room.id}`}>Explore room <span aria-hidden="true">→</span></a>
      <a class="small-book" href={room.bookingUrl} target="_blank" rel="noopener noreferrer">Book</a>
    </div>
  </div>
</article>
