---
interface Props {
  theme?: 'overlay' | 'solid';
  bookingUrl: string;
}

const { theme = 'overlay', bookingUrl } = Astro.props;
---

<header class:list={['site-header', `site-header--${theme}`]} data-site-header>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Hotel 3 Paardekens home">
      <img src="/images/legacy/brand/logo.png" alt="Hotel 3 Paardekens" />
    </a>

    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-nav-toggle>
      <span></span><span></span>
    </button>

    <nav class="main-nav" aria-label="Main navigation" data-main-nav>
      <a href="/#about">Hotel</a>
      <a href="/rooms">Rooms</a>
      <a href="/#breakfast">Breakfast</a>
      <a href="/#location">Mechelen</a>
      <a href="/#contact">Contact</a>
    </nav>

    <a class="header-book" href={bookingUrl} target="_blank" rel="noopener noreferrer">Book your stay</a>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = header?.querySelector('[data-nav-toggle]');
  const nav = header?.querySelector('[data-main-nav]');

  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('nav-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      header?.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
