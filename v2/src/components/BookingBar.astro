---
interface Props {
  bookingUrl: string;
}

const { bookingUrl } = Astro.props;
const baseBookingUrl = bookingUrl.split('?')[0];
---

<form class="booking-panel" data-booking-form data-booking-base={baseBookingUrl}>
  <div class="booking-field">
    <label for="hero-checkin">Arrival</label>
    <input id="hero-checkin" name="checkin" type="date" required data-checkin />
  </div>
  <div class="booking-field">
    <label for="hero-checkout">Departure</label>
    <input id="hero-checkout" name="checkout" type="date" required data-checkout />
  </div>
  <button class="booking-submit" type="submit">
    <span>Check availability</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </button>
</form>

<script>
  const pad = (value) => String(value).padStart(2, '0');
  const formatDate = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
  const addDays = (date, days) => {
    const next = new Date(date);
    next.setDate(next.getDate() + days);
    return next;
  };

  document.querySelectorAll('[data-booking-form]').forEach((form) => {
    const checkin = form.querySelector('[data-checkin]');
    const checkout = form.querySelector('[data-checkout]');
    if (!(checkin instanceof HTMLInputElement) || !(checkout instanceof HTMLInputElement)) return;

    const today = new Date();
    const tomorrow = addDays(today, 1);
    checkin.min = formatDate(today);
    checkin.value = checkin.value || formatDate(today);
    checkout.min = formatDate(tomorrow);
    checkout.value = checkout.value || formatDate(tomorrow);

    checkin.addEventListener('change', () => {
      const arrival = checkin.value ? new Date(`${checkin.value}T00:00:00`) : today;
      const minimumDeparture = addDays(arrival, 1);
      checkout.min = formatDate(minimumDeparture);
      if (!checkout.value || new Date(`${checkout.value}T00:00:00`) <= arrival) {
        checkout.value = formatDate(minimumDeparture);
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!checkin.value || !checkout.value) return;

      const base = form.getAttribute('data-booking-base');
      if (!base) return;

      const url = new URL(base);
      url.searchParams.set('mewsStart', checkin.value);
      url.searchParams.set('mewsEnd', checkout.value);
      url.searchParams.set('mewsRoute', 'rooms');
      window.open(url.toString(), '_blank', 'noopener,noreferrer');
    });
  });
</script>
