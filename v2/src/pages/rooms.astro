---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../../content/site.json';
import single from '../../content/rooms/single.json';
import twin from '../../content/rooms/twin.json';
import double from '../../content/rooms/double.json';

const rooms = [single, twin, double].sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="Rooms | Hotel 3 Paardekens Mechelen"
  description="Explore the Single, Twin and Double rooms at Hotel 3 Paardekens in central Mechelen and book directly through our official booking engine."
  image={double.gallery[0]}
>
  <Header theme="solid" bookingUrl={site.bookingUrl} />

  <main>
    <section class="page-hero">
      <div class="shell page-hero-grid">
        <div>
          <p class="eyebrow">Rooms at Hotel 3 Paardekens</p>
          <h1 class="display-title">Sleep well.<br />Wake up in Mechelen.</h1>
        </div>
        <p class="page-hero-copy">Choose the room that fits the way you travel. All three categories keep you right in the historic centre with the essentials for a comfortable city stay.</p>
      </div>
    </section>

    {rooms.map((room) => (
      <section class="room-detail" id={room.id}>
        <div class="shell room-detail-grid">
          <div class="room-detail-gallery" aria-label={`${room.name} gallery`}>
            {room.gallery.slice(0, 3).map((photo, index) => (
              <img src={photo} alt={`${room.name} photo ${index + 1}`} loading="lazy" />
            ))}
          </div>
          <div class="room-detail-copy">
            <p class="eyebrow">{room.strapline}</p>
            <h2>{room.name}</h2>
            <p>{room.description}</p>
            <ul class="amenities-list">
              {room.amenities.map((amenity) => <li>{amenity}</li>)}
            </ul>
            <a class="primary-button" href={room.bookingUrl} target="_blank" rel="noopener noreferrer">Check availability <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    ))}
  </main>

  <Footer site={site} />
</BaseLayout>
