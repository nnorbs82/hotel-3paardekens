---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BookingBar from '../components/BookingBar.astro';
import RoomCard from '../components/RoomCard.astro';
import Footer from '../components/Footer.astro';
import site from '../../content/site.json';
import single from '../../content/rooms/single.json';
import twin from '../../content/rooms/twin.json';
import double from '../../content/rooms/double.json';

const rooms = [single, twin, double].sort((a, b) => a.order - b.order);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`;
---

<BaseLayout
  title="Hotel 3 Paardekens | Historic Hotel in the Heart of Mechelen"
  description="Stay at Hotel 3 Paardekens in historic central Mechelen. Discover 33 rooms and a top-floor breakfast room with a memorable view of St Rumbold's Cathedral."
>
  <Header bookingUrl={site.bookingUrl} />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-media">
        <img src="/images/legacy/hotel/background.jpg" alt="Hotel 3 Paardekens in Mechelen" fetchpriority="high" />
      </div>
      <div class="hero-content">
        <div class="hero-copy">
          <p class="eyebrow">Hotel 3 Paardekens · Mechelen</p>
          <h1 class="hero-title" id="hero-title">{site.heroTitle}</h1>
          <p class="hero-intro">{site.heroText}</p>
        </div>
      </div>
      <span class="hero-scroll">Discover</span>
      <div class="booking-wrap">
        <BookingBar bookingUrl={site.bookingUrl} />
      </div>
    </section>

    <section class="intro-section" id="about">
      <div class="shell intro-grid">
        <div class="intro-images" aria-label="Hotel 3 Paardekens photography">
          <img class="intro-image-main" src="/images/legacy/about/aboutus1.jpg" alt="Hotel 3 Paardekens interior" loading="lazy" />
          <img class="intro-image-float" src="/images/legacy/about/aboutus3.jpg" alt="Guest room at Hotel 3 Paardekens" loading="lazy" />
        </div>
        <div class="intro-copy">
          <p class="eyebrow">{site.aboutEyebrow}</p>
          <h2 class="section-title">{site.aboutTitle}</h2>
          <p class="section-copy">{site.aboutBody}</p>
          <a class="text-link" href="/rooms">Explore our rooms <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="rooms-section" id="rooms">
      <div class="shell">
        <div class="section-heading-row">
          <div>
            <p class="eyebrow">Stay your way</p>
            <h2 class="section-title">Three room styles.<br />One central address.</h2>
          </div>
          <p class="section-copy">Single, Twin or Double - straightforward city rooms for sleeping well and stepping straight into historic Mechelen.</p>
        </div>
        <div class="rooms-grid">
          {rooms.map((room) => <RoomCard room={room} />)}
        </div>
      </div>
    </section>

    <section class="feature-section" id="breakfast" aria-labelledby="breakfast-title">
      <div class="feature-media">
        <img src="/images/legacy/about/aboutus2.jpg" alt="Hotel 3 Paardekens" loading="lazy" />
      </div>
      <div class="shell feature-content">
        <div class="feature-copy">
          <p class="eyebrow">A signature of the hotel</p>
          <h2 class="section-title" id="breakfast-title">{site.breakfastTitle}</h2>
          <p>{site.breakfastText}</p>
          <div class="feature-stat" aria-label="Breakfast room highlights">
            <div><strong>Top floor</strong><span>Breakfast room</span></div>
            <div><strong>Cathedral</strong><span>View across Mechelen</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="location-section" id="location">
      <div class="shell location-grid">
        <div class="location-card">
          <div>
            <p class="eyebrow">The city outside your door</p>
            <h2 class="section-title">Meet Mechelen from the middle of it.</h2>
            <p>Hotel 3 Paardekens sits in the historic centre, with the Grote Markt, St Rumbold's Cathedral and the city's streets within easy reach.</p>
          </div>
          <div>
            <div class="location-details">
              <div><span>Address</span><strong>Begijnenstraat 3</strong></div>
              <div><span>Setting</span><strong>Historic centre</strong></div>
            </div>
            <a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer" style="margin-top:28px">Open in Google Maps <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <img class="location-image" src="/images/legacy/rooms/Double/2.jpg" alt="Hotel 3 Paardekens guest room" loading="lazy" />
      </div>
    </section>

    <section class="sister-section">
      <div class="shell sister-grid">
        <img class="sister-image" src="/images/legacy/elisabeth/sisterhotel.jpg" alt="Hotel Elisabeth in Mechelen" loading="lazy" />
        <div class="sister-copy">
          <p class="eyebrow">Elegance · Comfort · Design</p>
          <h2 class="section-title">Discover our sister property.</h2>
          <p>{site.sisterHotelText}</p>
          <a class="text-link" href={site.sisterHotelUrl} target="_blank" rel="noopener noreferrer">Visit {site.sisterHotelName} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <Footer site={site} />
</BaseLayout>
